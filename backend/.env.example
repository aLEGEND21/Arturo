# Discord OAuth (backend/app/auth.py). Copy to backend/.env for local dev;
# on the VPS the same keys live in /opt/arturo/.env (docker-compose.prod.yml).
#
# From the Discord developer portal, OAuth2 tab. Register every redirect URI
# you use there, exactly: http://localhost:8000/api/auth/callback for
# `uvicorn` on the host, http://localhost:3000/api/auth/callback for local
# compose, and https://<your-domain>/api/auth/callback for prod.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where Discord sends the browser back, and where the dashboard lives.
# Prod: both are the public origin, https://tasks.arnavm.com/api/auth/callback
# and https://tasks.arnavm.com.
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback
ARTURO_APP_URL=http://localhost:3000

# Session lifetime in days (default 30).
# ARTURO_SESSION_DAYS=30
